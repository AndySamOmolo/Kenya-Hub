{"languageId":"somali","stories":[],"sentences":[{"text":"Burj Khalifa waa dhismaha hadda adduunka ugu dheer."},{"text":"Burj Khalifa waa sarta hadda adduunka ugu dheer."},{"text":"Guri waan leeyahay."},{"text":"Noloshaydu waa xuntahay."},{"text":"Waan wanaagsanahay."},{"text":"Ingiriis miyaad ku hadashaa?"},{"text":"Waan quruxsanahay."},{"text":"Magacaygu waa Maxamed."},{"text":"Waan akhrin doonaa buugga."},{"text":"Ku soo dhawaada Tatoeba!"},{"text":"Ku soo dhawoow Tatoeba!"},{"text":"Diidiinka ilko ma leh."},{"text":"Gacani keligeed ma sacaabayn karayso."},{"text":"Anigu ma xumi."},{"text":"Tom iyo Marie waxay go’aansadeen inay socdaan."},{"text":"Waa tani jawaabta su’aashada."},{"text":"Waxaan ku nolyahay Belfast."},{"text":"Aynu halkaa uga baxno sida ugu dhakhsaha badan ee aan awoodno."},{"text":"Gurigaada joog."},{"text":"Musqushu waa halkee?"},{"text":"Waa naag."},{"text":"Maxaad doonaysaa?"},{"text":"Waa gurigaygii."},{"text":"Magacaygu waa Tom."},{"text":"Kani ma aqalkaagii baa?"},{"text":"Aniga ninkii dilay."},{"text":"Maxaad u timid?"},{"text":"Muxuu ii sheegay?"},{"text":"Xaggeed tagaysaa?"},{"text":"Xaggeed tagtay?"},{"text":"Muxuu yidhi?"},{"text":"Ma haysaa?"},{"text":"Waan jirranahay."},{"text":"Naag ma leedahay?"},{"text":"Waa xun yahay."},{"text":"Waan kula hadlayaa."},{"text":"Sidee tahay?"},{"text":"Waa nin xun."},{"text":"Ma carab baa?"},{"text":"Askari ma aha."},{"text":"Kursi weyn baan doonayaa."},{"text":"Lacag ma lihi."},{"text":"Qoraxdu waa kulushahay."},{"text":"Ninkii naagtii buu dilay."},{"text":"Layla waxay kireysatay SUV."},{"text":"Tom wuxuu la koray John iyo Mary."},{"text":"Horey ayaan ula hadlay iyada."},{"text":"Tom si dhib yar waligiis guriga uma joogo Sabtiyada."},{"text":"Muxuu Tom u daahay?"},{"text":"Aniga kaligey waan sameyn karaa."},{"text":"Gabdhaha fasalkayga midkoodna kama qurux badna Linda."},{"text":"Waxaan sameynayay waxyaabo sharciga ka hor imanaya."},{"text":"Markab ayaa ku degay meel u dhow halkan shalay."},{"text":"Liisku waa sida soo socota."},{"text":"Halkaas keligaa ma tagi kartid."},{"text":"Mararka qaar waxaad ubaahantahay shukulaato."},{"text":"Mennad ayaa caawiyay hooyadiis."},{"text":"Kabaha barafka ayay xirtay."},{"text":"Waxaan u maleynayay in Tom uusan ku raaxeysan doonin safarka aniga."},{"text":"Goorma ayuu ku noqday Mareykanka?"},{"text":"Tom saxankiisii ​​ayuu iska fogeeyay."},{"text":"Wuu casheyn doonaa."},{"text":"Waxay ku andacoodaan in xagaaga soo socda uu noqon doono kan ugu kulul qarniga."},{"text":"Way ka caqli badan tahay sida ay u egtahay."},{"text":"Weligeen sidaas kumaanaan samayn."},{"text":"Waan daallan nahay oon harraadsan nahay."},{"text":"Waxaa jira warar xan ah oo sheegaya in xagjiriintu ay maleegayaan shirqool ka dhan ah dowladda."},{"text":"Waxaan goynay xarigga."},{"text":"Aljeeriya waa liidata."},{"text":"Sami maalin kasta wuu xirtaa jiinis."},{"text":"Ma dareentay gariir?"},{"text":"Waxaan jeclaan lahaa inaan u duulo sida shimbir oo kale."},{"text":"Tom wuxuu u maleynayay inaan guuleysan doonin."},{"text":"Tom raaligelin ayuu ka bixiyay arrintaas."},{"text":"Liza waxay lacagteeda oo dhan ku bixisaa dharka."},{"text":"Tom fardaha afkiisa ayuu salaaxay."},{"text":"Waxaan halkaan joogi doonaa dhowr saacadood oo dheeri ah."},{"text":"Si buuxda ayaan ugu raacsanahay tan."},{"text":"Aad baan ugu da' weynahay waxan oo kale."},{"text":"Waa inaad qaadataa jaakadeyda."},{"text":"Subax wanaagsan."},{"text":"Ayslaan waa jasiirad."},{"text":"Waa lix saac."},{"text":"Waa toban saac."},{"text":"Ma gabar baan ahay?"},{"text":"Kani waa Maxamed."},{"text":"Kani waa kumbuyuutar."},{"text":"Tani waa Xaddiyo."},{"text":"Maanta waa Sabti."},{"text":"Buuggu waa kan."},{"text":"Ma ihi arday."},{"text":"Maanta waa Jumce."},{"text":"Waa inaan tago."},{"text":"Magacaygu waa Cali."},{"text":"Waxay go'aansatay inay u guurto Belgium."},{"text":"waxaan doonayaa inaan diyaariyo maclumaad aan u isticmaalikaro barmaamuj cusub."},{"text":"Ingiriisiga ma ku hadashaa?"},{"text":"Waxaan leeyahay saddex bisadood."},{"text":"Waxaan leeyahay buug."},{"text":"Magacaygu waa Siciid."},{"text":"Magacaygu waa Cabdi."},{"text":"Magacaa?"},{"text":"Magaciisu waa Cali."},{"text":"Maxaad sheegtay?"},{"text":"Magaceedu waa Xaliimo."},{"text":"Muxuu sheegay?"},{"text":"Magaciisu ma Cali baa?"},{"text":"Magaceedu ma Maryan baa?"},{"text":"Magaciisu waa maxay?"},{"text":"Kani waa kuma?"},{"text":"Kani Muuse ma aha."},{"text":"Kani Cismaan ma aha."},{"text":"Tani Xaliimo ma aha."},{"text":"Muxuu qabaa?"},{"text":"Maxaad ka shaqeysaa?"},{"text":"Macalin baan ahay."},{"text":"Ma macalimad baa?"},{"text":"Macalin ma ihi."},{"text":"Ma ihi macalin."},{"text":"Waxaan ahay macalin."},{"text":"Waa macalimad."},{"text":"Isagu ma macalin baa?"},{"text":"Kani ma buug baa?"},{"text":"Xaggaad ku dhalatay?"},{"text":"Waxaan ku dhashay magaalo."},{"text":"Ma magaalo baad ku dhalatay?"},{"text":"Waxaan ku dhashay miyiga."},{"text":"Xagguu ku dhashay?"},{"text":"Waxuu ku dhashay Muqdisho."},{"text":"Waxay ku dhalatay magaalo."},{"text":"Waxaan ka imid Soomaaliya."},{"text":"Waxaan ka imid Turkiga."},{"text":"Xageed ka timid?"},{"text":"Maraykan baan ahay."},{"text":"Ma Soomaali baad tahay?"},{"text":"Ma magaalaad ku nooshahay?"},{"text":"Ma Itoobiiyaad ku nooshahay?"},{"text":"Nin baa libaax dilay."},{"text":"Maxaad dooneysaa?"},{"text":"Inaad tagto baan doonayaa."},{"text":"Maxaad u iman wayday?"},{"text":"Geel badan ma leedahay?"},{"text":"Way dhowdahay."},{"text":"Waan ogahay."},{"text":"Arday baan ahay."},{"text":"Maroodigu ma weyn yahay?"},{"text":"Maroodigu waa weyn yahay."},{"text":"Hambalyo!"},{"text":"Saaxiibo ma nihin"},{"text":"Sigaar ma heeysaa?"}],"newsArticles":[],"externalLinks":[]}
