{
    "projectId": "6a3290500003e21b7fe1",
    "projectName": "Kenya Hub",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "tablesDB": [
        {
            "$id": "kenyahub-db",
            "name": "KenyaHub Database",
            "enabled": true
        }
    ],
    "tables": [
        {
            "$id": "blogs",
            "$permissions": [
                "read(\"any\")",
                "create(\"team:admins\")",
                "update(\"team:admins\")",
                "delete(\"team:admins\")",
                "create(\"label:admin\")",
                "update(\"label:admin\")",
                "delete(\"label:admin\")"
            ],
            "databaseId": "kenyahub-db",
            "name": "Blogs",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "title",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 255
                },
                {
                    "key": "slug",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 255
                },
                {
                    "key": "excerpt",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 500
                },
                {
                    "key": "author",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 255
                },
                {
                    "key": "content",
                    "type": "longtext",
                    "required": true,
                    "default": null
                },
                {
                    "key": "coverImage",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 2048
                },
                {
                    "key": "publishedAt",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 50
                },
                {
                    "key": "updatedAt",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 50
                },
                {
                    "key": "tags",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 50,
                    "array": true
                },
                {
                    "key": "readTime",
                    "type": "integer",
                    "required": true,
                    "default": null
                }
            ],
            "indexes": [
                {
                    "key": "idx_slug",
                    "type": "unique",
                    "status": "available",
                    "columns": ["slug"]
                },
                {
                    "key": "idx_published_at",
                    "type": "key",
                    "status": "available",
                    "columns": ["publishedAt"]
                }
            ]
        },
        {
            "$id": "contributions",
            "$permissions": [
                "create(\"any\")",
                "read(\"team:admins\")",
                "update(\"team:admins\")",
                "delete(\"team:admins\")",
                "read(\"label:admin\")",
                "update(\"label:admin\")",
                "delete(\"label:admin\")"
            ],
            "databaseId": "kenyahub-db",
            "name": "Language Contributions",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "language",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 64
                },
                {
                    "key": "type",
                    "type": "varchar",
                    "required": true,
                    "default": "new_word",
                    "size": 32
                },
                {
                    "key": "english",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 500
                },
                {
                    "key": "translation",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 500
                },
                {
                    "key": "pronunciation",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 255
                },
                {
                    "key": "context",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 1000
                },
                {
                    "key": "category",
                    "type": "varchar",
                    "required": false,
                    "default": "phrases",
                    "size": 64
                },
                {
                    "key": "contributorName",
                    "type": "varchar",
                    "required": true,
                    "default": "Community Contributor",
                    "size": 120
                },
                {
                    "key": "contributorEmail",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 255
                },
                {
                    "key": "submittedAt",
                    "type": "varchar",
                    "required": true,
                    "default": null,
                    "size": 50
                },
                {
                    "key": "status",
                    "type": "varchar",
                    "required": true,
                    "default": "pending",
                    "size": 32
                },
                {
                    "key": "customLanguageName",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 120
                },
                {
                    "key": "audioFileId",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 120
                },
                {
                    "key": "audioUrl",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 500
                },
                {
                    "key": "audioMimeType",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 64
                },
                {
                    "key": "syncedToR2",
                    "type": "boolean",
                    "required": false,
                    "default": false
                },
                {
                    "key": "reviewNotes",
                    "type": "varchar",
                    "required": false,
                    "default": null,
                    "size": 500
                }
            ],
            "indexes": [
                {
                    "key": "idx_status",
                    "type": "key",
                    "status": "available",
                    "columns": ["status"]
                },
                {
                    "key": "idx_language",
                    "type": "key",
                    "status": "available",
                    "columns": ["language"]
                }
            ]
        }
    ],
    "buckets": [
        {
            "$id": "contribution-audio",
            "name": "Contribution Audio",
            "enabled": true,
            "maximumFileSize": 5242880,
            "allowedFileExtensions": [
                "mp3",
                "wav",
                "m4a",
                "ogg",
                "opus",
                "webm",
                "aac"
            ],
            "$permissions": [
                "create(\"any\")",
                "read(\"any\")",
                "delete(\"team:admins\")",
                "delete(\"label:admin\")"
            ],
            "fileSecurity": false,
            "antivirus": true,
            "encryption": true
        }
    ]
}