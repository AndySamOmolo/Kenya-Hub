{
  "name": "kenyahub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/clean-removed-tools.mjs",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096\" next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --noEmit",
    "test": "node scripts/test-core-logic.mjs",
    "audit:tools": "node scripts/audit-tools.mjs",
    "audit:tools:sources": "node scripts/audit-tools.mjs --check-sources",
    "audit:tools:strict": "node scripts/audit-tools.mjs --strict",
    "deploy": "npm run build && npx wrangler pages deploy out --project-name kenyahub",
    "ingest:datasets": "node scripts/ingest-external-datasets.mjs",
    "sync:r2-audio": "node scripts/sync-cloudflare-r2-audio.mjs",
    "audit:e2e": "npx -y -p @playwright/test playwright test",
    "audit:e2e:live": "BASE_URL=https://kenyahub.me npx -y -p @playwright/test playwright test",
    "ingest:text": "python3 scripts/ingest-permissive-text-datasets.py --only-ungated --max-rows=2500",
    "ingest:cldf-civic": "python3 scripts/ingest-cldf-wikimedia-civic.py --track=all"
  },
  "dependencies": {
    "appwrite": "^16.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next": "^16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "node-appwrite": "^26.2.0",
    "serve": "^14.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
