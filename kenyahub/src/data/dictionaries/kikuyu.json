    {
      "id": "proverbs",
      "name": "Proverbs & Wisdom (Thimo)",
      "icon": "📜",
      "entries": [
        {
          "english": "Many hands make light work",
          "translation": "Indo nĩ kũrĩmithanio",
          "pronunciation": "een-doh nee koo-ree-mee-thah-nyoh",
          "context": "Lit. 'Riches are found in cultivating together.' Community unity yields abundant harvest.",
          "audioFile": null
        },
        {
          "english": "United we stand, divided we fall",
          "translation": "Kaara kamwe gatingĩyũragĩra ndaa",
          "pronunciation": "kah-ah-rah kah-mweh gah-teen-gee-yoo-rah-gee-rah n-dah-ah",
          "context": "Lit. 'One finger does not kill a louse.' Teamwork and unity are essential for success.",
          "audioFile": null
        },
        {
          "english": "Like father, like son",
          "translation": "Kaana ka ngarĩ gakunyaga ta nyina",
          "pronunciation": "kah-ah-nah kah n-gah-ree gah-koo-nyah-gah tah nyee-nah",
          "context": "Lit. 'The cub of a leopard scratches like its mother.' Children inherit their parents' habits.",
          "audioFile": null
        },
        {
          "english": "Where there is a will there is a way",
          "translation": "Mageria nomo mahota",
          "pronunciation": "mah-geh-ree-ah noh-moh mah-hoh-tah",
          "context": "Lit. 'Persistent trials mean success.' Continuous effort overcomes obstacles.",
          "audioFile": null
        },
        {
          "english": "Old age is honourable",
          "translation": "Kahiga gakũrũ gatiagararagwo nĩ maai",
          "pronunciation": "kah-hee-gah gah-koo-roo gah-tee-ah-gah-rah-rah-gwoh nee mah-ah-ee",
          "context": "Lit. 'The stream does not jump over an ancient rock.' Respect for elders and history.",
          "audioFile": null
        },
        {
          "english": "Do not wash dirty linen in public",
          "translation": "Cia mũciĩ itiumaga ndira",
          "pronunciation": "chee-ah moo-chee-ee ee-tee-oo-mah-gah n-dee-rah",
          "context": "Lit. 'Home matters must not venture into the open fields.' Keep family matters private.",
          "audioFile": null
        },
        {
          "english": "A good name is better than riches",
          "translation": "Gũkũra nĩ kũona, kũhũna ti gũtonga",
          "pronunciation": "goo-koo-rah nee koo-oh-nah koo-hoo-nah tee goo-tohn-gah",
          "context": "To grow old is to gain insight; mere fulness of belly is not lasting wealth.",
          "audioFile": null
        },
        {
          "english": "Truth will prevail",
          "translation": "Kĩhooto gĩtĩkũragwo nĩ rũũĩ",
          "pronunciation": "kee-hoh-oh-toh gee-tee-koo-rah-gwoh nee roo-oo-ee",
          "context": "Lit. 'Justice / moral truth cannot be swept away by a river.' Truth stands firm forever.",
          "audioFile": null
        },
        {
          "english": "The early bird catches the worm",
          "translation": "Mũũkĩrĩ tene acokaga tene",
          "pronunciation": "moo-oo-kee-ree teh-neh ah-choh-kah-gah teh-neh",
          "context": "Lit. 'He who wakes early returns home early.' Promptness leads to success.",
          "audioFile": null
        },
        {
          "english": "A friend in need is a friend indeed",
          "translation": "Mũrata wa ma onekaga thĩĩna-inĩ",
          "pronunciation": "moo-rah-tah wah mah oh-neh-kah-gah thee-ee-nah-ee-nee",
          "context": "A genuine friend proves loyalty during days of hardship and difficulty.",
          "audioFile": null
        }
      ]
    },
