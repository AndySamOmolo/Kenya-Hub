      "id": "greetings",
      "name": "Greetings & Farewells",
      "icon": "👋",
      "entries": [
        {
          "english": "Hello / Morning greeting",
          "translation": "Bwakiire",
          "pronunciation": "bwah-kee-reh",
          "context": "Universal morning salutation (lit. 'How did you wake up?')",
          "audioFile": null
        },
        {
          "english": "Response: I am well",
          "translation": "Mbuya mono",
          "pronunciation": "m-boo-yah moh-noh",
          "context": "Standard reply to Bwakiire ('Very well / good')",
          "audioFile": null
        },
        {
          "english": "Afternoon / Evening greeting",
          "translation": "Bwairire",
          "pronunciation": "bwah-ee-ree-reh",
          "context": "Salutation used from midday onwards into dusk",
          "audioFile": null
        },
        {
          "english": "How are you?",
          "translation": "Naki ase?",
          "pronunciation": "nah-kee ah-seh",
          "context": "Common conversational inquiry",
          "audioFile": null
        },
        {
          "english": "I am fine / well",
          "translation": "Ndi botire",
          "pronunciation": "n-dee boh-tee-reh",
          "context": "Standard affirmative reply",
          "audioFile": null
        },
        {
          "english": "Good morning (Daylight)",
          "translation": "Orogoro",
          "pronunciation": "oh-roh-goh-roh",
          "context": "Salutation honoring the early morning sunlight",
          "audioFile": null
        },
        {
          "english": "Thank you",
          "translation": "Ase / Buya mono",
          "pronunciation": "ah-seh / boo-yah moh-noh",
          "context": "'Ase mono' = thank you very much",
          "audioFile": null
        },
        {
          "english": "Goodbye / We shall see each other",
          "translation": "Togokoana",
          "pronunciation": "toh-goh-koh-ah-nah",
          "context": "Courteous parting phrase",
          "audioFile": null
        },
        {
          "english": "Go well",
          "translation": "Genda buya",
          "pronunciation": "gehn-dah boo-yah",
          "context": "Blessing spoken to departing traveler",
          "audioFile": null
        },
        {
          "english": "Stay well",
          "translation": "Manya buya",
          "pronunciation": "mah-nyah boo-yah",
          "context": "Spoken to the host remaining behind",
          "audioFile": null
        }
      ]
