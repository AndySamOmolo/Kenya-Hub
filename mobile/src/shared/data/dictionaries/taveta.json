          "audioFile": null
        },
        {
          "english": "If you kill a snake, kill it entirely (Proverb #6)",
          "translation": "Ukakoma nyoka, mhome na kamwe",
          "pronunciation": "u-ka-ko-ma nyo-ka mho-me na kam-we",
          "context": "A. C. Hollis (1910) 'Taveta Sayings and Proverbs' #6",
          "audioFile": null
        },
        {
          "english": "Of the hyena that howls and that does not howl, the bad one is the one that does not howl (Proverb #8)",
          "translation": "Ibau liiya na lisiiya, iwiwi ni lisiiya",
          "pronunciation": "i-bau lii-ya na li-sii-ya i-wi-wi ni li-sii-ya",
          "context": "A. C. Hollis (1910) 'Taveta Sayings and Proverbs' #8",
          "audioFile": null
        },
        {
          "english": "If one bird ceases singing the dawn will not stop (Proverb #10)",
          "translation": "Ideghe imwe likaremwa kuiya teheshigha kucha",
          "pronunciation": "i-de-ghe im-we li-ka-rem-wa kui-ya te-he-shi-gha ku-cha",
          "context": "A. C. Hollis (1910) 'Taveta Sayings and Proverbs' #10",
          "audioFile": null
        },
        {
          "english": "The elephant's bed is slept on by the gazelle (Proverb #14)",
          "translation": "Iraro la zowu liyaiwa ni suni",
          "pronunciation": "i-ra-ro la zo-wu li-yai-wa ni su-ni",
